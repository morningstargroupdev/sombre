STAGED=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0
UNSTAGED=$(git -c core.quotePath=false diff --name-only)
PARTIAL=""
FULL=$STAGED
if [ -n "$UNSTAGED" ]; then
  PARTIAL=$(printf '%s\n' "$STAGED" | grep -Fx -- "$UNSTAGED" || true)
fi
if [ -n "$PARTIAL" ]; then
  FULL=$(printf '%s\n' "$STAGED" | grep -Fxv -- "$PARTIAL" || true)
fi
if printf '%s\n' "$FULL" | grep -qx bun.lock; then
  perl -pi -e 's#"https://[^"]+/-/[^"]+\.tgz"#""#g' bun.lock
fi
CODE=0
FORMATTED=$(printf '%s\n' "$STAGED" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|mts|cts|json|jsonc|css|md|mdx|html|yml|yaml|toml)$' || true)
if [ -n "$FORMATTED" ]; then
  printf '%s\n' "$FORMATTED" | tr '\n' '\0' | xargs -0 bunx ultracite fix || CODE=$?
fi
printf '%s\n' "$FULL" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done
if [ -n "$PARTIAL" ]; then
  echo "Fixes to partially staged files were left unstaged:"
  printf '%s\n' "$PARTIAL" | sed 's/^/  /'
fi
exit $CODE
